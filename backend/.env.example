# Copy these values into your shell environment for local development.
APP_ENV=local
APP_NAME=siderfold-backend
HOST=127.0.0.1
PORT=8000

# Compose publishes PostgreSQL on an ephemeral host port. Replace 5432 with
# the value printed by: docker compose --project-name siderfold port db 5432
DATABASE_URL=postgresql+psycopg://siderfold:siderfold@127.0.0.1:5432/siderfold
DATABASE_CONNECT_TIMEOUT_SECONDS=2

# Локальный одноразовый scheduler. Никаких фоновых процессов или внешних
# уведомлений эти настройки не включают.
SCHEDULER_MAX_ATTEMPTS=3
SCHEDULER_INITIAL_BACKOFF_SECONDS=2
SCHEDULER_MAX_BACKOFF_SECONDS=60
SCHEDULER_RETRY_AFTER_MAX_SECONDS=60
SCHEDULER_RUN_LEASE_SECONDS=900
SCHEDULER_JOURNAL_RETENTION_DAYS=90

# Только для миграционных и инвариантных тестов. Имя БД должно оканчиваться на
# _test, чтобы тестовый rollback не был направлен на рабочую БД.
TEST_DATABASE_URL=postgresql+psycopg://siderfold:siderfold@127.0.0.1:5432/siderfold_test
